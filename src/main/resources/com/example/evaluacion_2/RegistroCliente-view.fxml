<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.evaluacion_2.Controller.RegistroClienteController">

    <top>
        <VBox spacing="4">
            <padding>
                <Insets top="16" left="20" right="20"/>
            </padding>

            <Label
                    text="Registro de cliente"
                    style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Complete los datos obligatorios para guardar el cliente."/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="12" vgap="10">
            <padding>
                <Insets top="18" bottom="18" left="20" right="20"/>
            </padding>

            <Label text="Nombres:" GridPane.rowIndex="0"/>
            <TextField
                    fx:id="txtNombres"
                    promptText="Ingrese los nombres"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0"/>

            <Label text="Apellidos:" GridPane.rowIndex="1"/>
            <TextField
                    fx:id="txtApellidos"
                    promptText="Ingrese los apellidos"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1"/>

            <Label text="Tipo de cliente:" GridPane.rowIndex="2"/>
            <ComboBox
                    fx:id="cmbTipoCliente"
                    prefWidth="210"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="2"/>

            <Label text="Ciudad:" GridPane.rowIndex="3"/>
            <ComboBox
                    fx:id="cmbCiudad"
                    prefWidth="210"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="3"/>

            <Label text="Fecha de nacimiento:" GridPane.rowIndex="4"/>
            <DatePicker
                    fx:id="dpFechaNacimiento"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="4"/>

            <Label text="Tipo de solicitud:" GridPane.rowIndex="5"/>
            <VBox
                    spacing="4"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="5">
                <RadioButton fx:id="rbConsulta" text="Consulta"/>
                <RadioButton fx:id="rbSoporte" text="Soporte"/>
                <RadioButton fx:id="rbServicio" text="Servicio"/>
            </VBox>

            <Label text="Servicios de interés:" GridPane.rowIndex="6"/>
            <VBox
                    spacing="4"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="6">
                <CheckBox fx:id="chkInternet" text="Internet"/>
                <CheckBox fx:id="chkSoporte" text="Soporte técnico"/>
                <CheckBox fx:id="chkSoftware" text="Software"/>
            </VBox>

            <Label text="Fotografía:" GridPane.rowIndex="7"/>
            <VBox
                    spacing="8"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="7">
                <ImageView
                        fx:id="imgFotografia"
                        fitWidth="150"
                        fitHeight="120"
                        preserveRatio="true"
                        style="-fx-border-color: lightgray;"/>
                <Button
                        text="Seleccionar fotografía"
                        onAction="#seleccionarFotografia"/>
            </VBox>

            <HBox
                    spacing="10"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="8">
                <Button text="Guardar" onAction="#guardarCliente"/>
                <Button text="Limpiar" onAction="#limpiarFormulario"/>
                <Button text="Cancelar" onAction="#cancelar"/>
                <Button
                        text="Consultar clientes"
                        onAction="#abrirConsulta"/>
            </HBox>
        </GridPane>
    </center>
</BorderPane>
